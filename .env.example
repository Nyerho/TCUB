# Existing Firebase project: obtain browser values from Firebase Console > Project settings > General
FIREBASE_PROJECT_ID=tcub-b96a6
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
