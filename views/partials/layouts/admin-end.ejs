      </div>
    </div>
  </div>
  <% if (typeof error !== 'undefined' && error) { %>
    <div id="toast-error" class="alert alert-danger" style="position:fixed;top:20px;right:20px;z-index:9999;max-width:400px;box-shadow:0 10px 30px rgba(0,0,0,0.15);">
      <span class="alert-icon"></span>
      <div class="alert-content">
        <div class="alert-title">Error</div>
        <p class="alert-message"><%= error %></p>
      </div>
    </div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div id="toast-success" class="alert alert-success" style="position:fixed;top:20px;right:20px;z-index:9999;max-width:400px;box-shadow:0 10px 30px rgba(0,0,0,0.15);">
      <span class="alert-icon"></span>
      <div class="alert-content">
        <div class="alert-title">Success</div>
        <p class="alert-message"><%= success %></p>
      </div>
    </div>
  <% } %>
  <script>
    window.captureFreezeReason = function (form, isCurrentlyFrozen) {
      if (isCurrentlyFrozen) return true;
      const reason = window.prompt('Enter the reason for freezing this account. This will be included in the customer email:', 'Account security review');
      if (reason === null) return false;
      const field = form.querySelector('input[name="reason"]');
      if (field) field.value = reason.trim().slice(0, 500);
      return true;
    };

    window.showActionToast = function (type, message) {
      document.querySelectorAll('.live-action-toast').forEach((toast) => toast.remove());
      const toast = document.createElement('div');
      toast.className = `alert ${type === 'success' ? 'alert-success' : 'alert-danger'} live-action-toast`;
      toast.style.cssText = 'position:fixed;top:20px;right:20px;z-index:10000;max-width:420px;box-shadow:0 10px 30px rgba(0,0,0,0.18);';
      toast.innerHTML = `<span class="alert-icon">${type === 'success' ? '✓' : '⚠️'}</span><div class="alert-content"><div class="alert-title">${type === 'success' ? 'Success' : 'Action failed'}</div><p class="alert-message"></p></div>`;
      toast.querySelector('.alert-message').textContent = message || (type === 'success' ? 'Action completed successfully.' : 'The action could not be completed.');
      document.body.appendChild(toast);
      window.setTimeout(() => toast.remove(), 6500);
    };

    function showServerToast(parsedDocument) {
      const success = parsedDocument.querySelector('#toast-success .alert-message');
      const error = parsedDocument.querySelector('#toast-error .alert-message');
      if (success) window.showActionToast('success', success.textContent.trim());
      else if (error) window.showActionToast('error', error.textContent.trim());
      return Boolean(success || error);
    }

    // Submit admin POST forms without a full-page refresh. Forms with file inputs
    // opt out so uploads continue through the browser's native multipart handling.
    document.addEventListener('submit', async (event) => {
      const form = event.target.closest('form');
      if (!form || form.method.toUpperCase() !== 'POST' || form.dataset.nativeSubmit === 'true' || form.dataset.submitting === 'true' || form.querySelector('input[type="file"]')) return;
      event.preventDefault();
      form.dataset.submitting = 'true';
      const submitButton = form.querySelector('button[type="submit"]');
      const originalLabel = submitButton ? submitButton.innerHTML : '';
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.innerHTML = 'Saving…';
      }
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form)),
          credentials: 'same-origin',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
          }
        });
        if (!response.ok) throw new Error(`Request failed (${response.status})`);
        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
          const data = await response.json();
          if (!data.success) throw new Error(data.message || 'The action was not completed.');
          window.showActionToast('success', data.message || 'Action completed successfully.');
          form.dataset.submitting = 'false';
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.innerHTML = originalLabel;
          }
          return;
        }
        const html = await response.text();
        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const currentShell = document.querySelector('.main');
        const nextShell = parsed.querySelector('.main');
        if (!currentShell || !nextShell) throw new Error('Updated admin page could not be rendered.');
        currentShell.innerHTML = nextShell.innerHTML;
        const hadServerToast = showServerToast(parsed);
        if (!hadServerToast) window.showActionToast('success', 'Action completed successfully.');
        const nextUrl = new URL(response.url, window.location.origin);
        window.history.pushState({}, '', nextUrl.pathname + nextUrl.search);
        window.scrollTo({ top: 0, behavior: 'smooth' });
        document.dispatchEvent(new CustomEvent('admin:content-updated'));
      } catch (error) {
        form.dataset.submitting = 'false';
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.innerHTML = originalLabel;
        }
        window.showActionToast('error', `Could not complete the action: ${error.message}`);
      }
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script src="/js/common.js"></script>
  <% if (typeof pageScripts !== 'undefined' && pageScripts) { pageScripts.forEach(s => { %>
    <script src="<%= s %>"></script>
  <% }) } %>
</body>
</html>
