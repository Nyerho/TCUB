# Copy to .dev.vars for local Cloudflare development. Never commit .dev.vars.
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-local-secret
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-local-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_ROLE=super_admin
ADMIN_PHONE=
SUPPORT_EMAIL=support@example.test
APP_BASE_URL=http://localhost:8787
JIVO_WIDGET_ID=

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ADMIN_UID=

BREVO_API_KEY=
BREVO_SENDER_NAME=Think Union Credit Bank
EMAIL_FROM=
EMAIL_REPLY_TO=

# Optional Firestore collection overrides
FIREBASE_ADMIN_COLLECTION=
FIREBASE_ADMIN_DOC_ID=
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_ACCOUNTS_COLLECTION=accounts
FIRESTORE_TRANSACTIONS_COLLECTION=transactions
