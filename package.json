{
  "name": "think-union-credit-bank",
  "version": "1.0.0",
  "description": "Think Union Credit Bank - Modern Digital Credit Union Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "cf:templates": "node scripts/compile-templates.js",
    "cf:dev": "wrangler dev --config wrangler.jsonc --local",
    "cf:mock": "wrangler dev --config wrangler.mock.jsonc --local",
    "cf:test": "node --test test/worker.test.js",
    "cf:deploy": "wrangler deploy --config wrangler.jsonc",
    "netlify:build": "node -e \"console.log('Netlify build: serverless Express function ready')\"",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "9.6.0",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "firebase-admin": "^14.5.1",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "serverless-http": "^3.2.0"
  },
  "overrides": {
    "jwks-rsa": "3.1.0"
  },
  "devDependencies": {
    "netlify-cli": "^23.10.0",
    "node-gyp": "^13.0.1",
    "nodemon": "^3.1.4",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": "20.x"
  }
}
