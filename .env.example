# Netlify runtime
NODE_ENV=production
NETLIFY=true
SESSION_SECRET=
APP_BASE_URL=https://your-domain.example

# Application bootstrap values
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_ROLE=super_admin
ADMIN_PHONE=
SUPPORT_EMAIL=support@your-domain.example
JIVO_WIDGET_ID=

# Firebase browser configuration used by the client UI
FIREBASE_PROJECT_ID=tcub-b96a6
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Admin values are required for Firestore-backed login,
# registration sync, and admin dashboard data. Never commit service-account keys.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Brevo HTTP email provider. EMAIL_FROM must be a verified Brevo sender.
BREVO_API_KEY=
BREVO_SENDER_NAME=Think Union Credit Bank
EMAIL_FROM=
EMAIL_REPLY_TO=
