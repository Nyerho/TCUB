{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcub",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "alias": {
    "express": "./src/express-worker.js"
  },
  "find_additional_modules": true,
  "preserve_file_names": true,
  "rules": [
    {
      "type": "CommonJS",
      "globs": ["**/*.generated.js"],
      "fallthrough": false
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TCUB_APP",
        "class_name": "TCUBApp"
      }
    ]
  },
  "exports": {
    "TCUBApp": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "NODE_ENV": "production"
  }
}
